{
  "name": "devvault",
  "version": "1.0.0",
  "description": "Personal knowledge management MCP server for Claude Code - Save, search, and organize development notes with AI",
  "main": "dist/mcp-server/server.js",
  "bin": {
    "devvault": "dist/mcp-server/server.js"
  },
  "preferGlobal": true,
  "scripts": {
